PORT=3000
HOST=127.0.0.1
PAGENT_TIMEZONE=Europe/Samara
PAGENT_AI_MODEL=gpt-5.6-luna
OPENAI_API_KEY=
OPENROUTER_API_KEY=
PAGENT_OPENROUTER_MODEL=
PAGENT_OPENROUTER_MODELS=
PAGENT_OPENROUTER_TIMEOUT_MS=30000
PAGENT_AI_PROVIDER=fallback
PAGENT_CODEX_PATH=codex
PAGENT_CODEX_MODEL=
PAGENT_CLAUDE_PATH=claude
PAGENT_CLAUDE_MODEL=claude-haiku-4-5
PAGENT_CLI_TIMEOUT_MS=60000
PAGENT_CLI_MAX_CONCURRENCY=1
PAGENT_CLI_MAX_QUEUE=3

# Голосовой диалог (речь в речь). Пока ключа нет, разговор идёт по правилам —
# записи настоящие, но голоса не будет. Ключ используется только на сервере:
# браузер получает короткоживущий токен.
# Провайдер выбирается по ключу; при двух ключах — по PAGENT_VOICE_PROVIDER
# (openai | gemini).
# Модель разговора выбирается списком в «Настройки → Разговор»: список приходит
# от провайдера, а здесь — то, с чего начать, пока в настройках не выбрали своё.
PAGENT_VOICE_PROVIDER=
PAGENT_VOICE_MODEL=gpt-realtime
PAGENT_VOICE_NAME=marin
GEMINI_API_KEY=
PAGENT_GEMINI_VOICE_MODEL=models/gemini-3.1-flash-live-preview
PAGENT_GEMINI_VOICE_NAME=Puck

# ── Учётные записи ──
# Приложение закрыто входом: первый зарегистрировавшийся становится
# администратором и забирает себе журнал, который вёлся до обновления.
# За HTTPS кука сессии помечается Secure. За обычным http это ломало бы вход,
# поэтому по умолчанию выключено.
PAGENT_SECURE_COOKIES=

# ── Предел расхода на разговор ──
# Задаётся в приложении (Настройки → Предел разговора) и хранится в базе.
# Здесь только напоминание, что цены по умолчанию нет: звук идёт мимо сервера,
# поэтому минуты мы знаем, а деньги — только если указать цену за минуту.
# Предел по минутам работает и без цены.

# ── Google как модель разбора ──
# Ключ тот же, что у голоса (GEMINI_API_KEY либо GOOGLE_API_KEY): это один и тот
# же доступ к Generative Language API. Модель по умолчанию — первая быстрая из
# каталога Google; своим списком можно сузить выбор.
PAGENT_GEMINI_MODEL=
PAGENT_GEMINI_MODELS=

# Telegram search, summaries and calendar are public for active users with
# a private binding. Scheduled messages remain opt-in.
# Legacy PAGENT_TELEGRAM_TASK_SEARCH_USER_IDS and
# PAGENT_TELEGRAM_DAY_SUMMARY_USER_IDS settings are ignored.

# Иллюстрации отчётов: auto использует существующий OpenAI/Gemini ключ.
# Без ключа или при ошибке — готовая сезонная картинка Кизуны.
# Один общий результат на дату и утро/вечер; не более двух генераций в день.
# off отключает картинки, openai/gemini явно выбирают провайдера.
PAGENT_REPORT_IMAGE_PROVIDER=auto
# По умолчанию gpt-image-1 для OpenAI, gemini-2.5-flash-image для Gemini.
PAGENT_REPORT_IMAGE_MODEL=

# Optional illustrated appearance. Off until a reviewed release is enabled.
PAGENT_WORKSHOP_MODE=off
# UUIDs separated by commas or spaces; used only in allowlist mode.
PAGENT_WORKSHOP_USER_IDS=
