{
  "name": "pagent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22 || ^24 || >=26"
  },
  "scripts": {
    "dev": "NODE_EXTRA_CA_CERTS=${NODE_EXTRA_CA_CERTS:-/etc/ssl/cert.pem} node --watch server/index.js",
    "start": "NODE_EXTRA_CA_CERTS=${NODE_EXTRA_CA_CERTS:-/etc/ssl/cert.pem} node server/index.js",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "smoke:provider": "node server/smoke-provider.js",
    "build:draft-recovery": "node scripts/build-draft-recovery.mjs",
    "check:draft-recovery": "node scripts/build-draft-recovery.mjs --check",
    "logs:report": "node scripts/log-report.mjs",
    "monitoring:check": "node ops/monitoring/check.mjs",
    "pretest": "npm run check:draft-recovery",
    "monitoring:smoke": "node ops/monitoring/smoke.mjs"
  },
  "dependencies": {
    "@prometheus-io/client": "0.16.1",
    "better-sqlite3": "^12.2.0",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "openai": "^5.12.2",
    "qrcode": "^1.5.4",
    "web-push": "^3.6.7",
    "y-indexeddb": "9.0.12",
    "yjs": "13.6.27",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "esbuild": "0.28.2",
    "supertest": "^7.1.4"
  }
}
